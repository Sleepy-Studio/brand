      }]
    },
    {
      "id": "logo-white",
      "name": "Logo White",
      "description": "White variant of the Sleepy Studio logo",
      "added": "2026-08-02",
      "variants": [{
        "format": "svg",
        "file": "logos/svg/LogoWhite.svg",
