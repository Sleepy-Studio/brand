{
  "$schema": "https://raw.githubusercontent.com/Sleepy-Studio/contracts/main/schemas/asset-manifest.schema.json",
  "version": "1.2.0",
  "ref": "main",
  "repository": "https://github.com/Sleepy-Studio/brand",
  "description": "Sleepy Studio canonical asset manifest. Runtime consumers should resolve installed assets through @sleepy-studio/brand/assets/runtime; production manifests should use release-tagged URLs.",
  "assets": [
    {
      "id": "logo-black",
      "name": "Logo Black",
      "description": "Canonical black Sleepy Studio logo generated from the black-red source geometry using the Brand black token",
      "added": "2026-08-02",
      "variants": [{ "format": "svg", "file": "logos/svg/LogoBlack.svg", "size_kb": 10.06, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoBlack.svg", "mime": "image/svg+xml" }]
    },
    {
      "id": "logo-red",
      "name": "Logo Red",
      "description": "Canonical red Sleepy Studio logo generated from the black-red source geometry using the Brand red token",
      "added": "2026-08-09",
      "variants": [{ "format": "svg", "file": "logos/svg/LogoRed.svg", "size_kb": 10.0, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoRed.svg", "mime": "image/svg+xml" }]
    },
    {
      "id": "logo-black-red",
      "name": "Logo Black Red",
      "description": "Black Sleepy Studio logo with red accent",
      "added": "2026-08-02",
      "variants": [{ "format": "svg", "file": "logos/svg/LogoBlackRed.svg", "size_kb": 9.93, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoBlackRed.svg", "mime": "image/svg+xml" }]
    },
    {
      "id": "logo-white",
      "name": "Logo White",
      "description": "White variant of the Sleepy Studio logo",
      "added": "2026-08-02",
      "variants": [{ "format": "svg", "file": "logos/svg/LogoWhite.svg", "size_kb": 10.34, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoWhite.svg", "mime": "image/svg+xml" }]
    },
    {
      "id": "logo-white-red",
      "name": "Logo White Red",
      "description": "White Sleepy Studio logo with red accent",
      "added": "2026-08-02",
      "variants": [{ "format": "svg", "file": "logos/svg/LogoWhiteRed.svg", "size_kb": 10.07, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoWhiteRed.svg", "mime": "image/svg+xml" }]
    },
    {
      "id": "logo-yellow",
      "name": "Logo Yellow",
      "description": "Yellow Sleepy Studio logo using the canonical Brand yellow",
      "added": "2026-08-07",
      "variants": [
        { "format": "svg", "file": "logos/svg/LogoYellow.svg", "size_kb": 1.0, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoYellow.svg", "mime": "image/svg+xml" },
        { "format": "webp", "file": "logos/webp/LogoYellow.webp", "size_kb": 17.49, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/webp/LogoYellow.webp", "mime": "image/webp" }
      ]
    },
    {
      "id": "logo-3d",
      "name": "Logo 3D",
      "description": "3D model of the Sleepy Studio logo",
      "added": "2026-08-02",
      "variants": [{ "format": "glb", "file": "logos/glb/SleepyLogo3d.glb", "size_kb": 819.83, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/glb/SleepyLogo3d.glb", "mime": "model/gltf-binary" }]
    },
    {
      "id": "favicon",
      "name": "Favicon",
      "description": "Canonical browser favicon compatibility artifact",
      "added": "2026-08-04",
      "variants": [{ "format": "ico", "file": "favicon.ico", "size_kb": 3.78, "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/favicon.ico", "mime": "image/x-icon" }]
    }
  ],
  "usage": {
    "runtime": "import { getBrandAssetUrl } from '@sleepy-studio/brand/assets/runtime'",
    "development_manifest": "GET https://raw.githubusercontent.com/Sleepy-Studio/brand/main/assets.json",
    "release_manifest": "GET https://raw.githubusercontent.com/Sleepy-Studio/brand/{release-tag}/assets.json",
    "documentation": "See README.md and INTEGRATION.md"
  }
}
