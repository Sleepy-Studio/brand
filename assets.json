      "variants": [{
        "format": "svg",
        "file": "logos/svg/LogoBlackRed.svg",
        "size_kb": 9.93,
        "url": "https://raw.githubusercontent.com/Sleepy-Studio/brand/main/logos/svg/LogoBlackRed.svg",
