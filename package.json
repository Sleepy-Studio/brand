{
  "name": "@sleepy-studio/brand",
  "version": "1.3.0",
  "description": "Canonical Sleepy Studio identity, assets, palette, semantic visual language, motion, terminal identity, approved icons, and public destinations.",
  "type": "module",
  "files": ["assets.json", "assets", "links", "tokens", "icons", "identity", "styles", "logos", "characters", "3d-models", "app-icons", "favicon.ico", "README.md", "INTEGRATION.md"],
  "exports": {
    "./assets": "./assets.json",
    "./assets/runtime": "./assets/runtime.js",
    "./links/runtime": "./links/runtime.js",
    "./tokens": "./tokens/tokens.json",
    "./tokens.css": "./tokens/tokens.css",
    "./scrollbars.css": "./styles/scrollbars.css",
    "./icons": "./icons/icons.json",
    "./icons/runtime": "./icons/index.js",
    "./icons/*.svg": "./icons/svg/*.svg",
    "./identity/logo-motion": "./identity/logo-motion/dom.ts",
    "./identity/logo-motion/types": "./identity/logo-motion/types.ts",
    "./identity/logo-motion/style.css": "./identity/logo-motion/logo-motion.css",
    "./identity/logo-ascii": "./identity/logo-ascii/dom.ts",
    "./identity/logo-ascii/types": "./identity/logo-ascii/types.ts",
    "./identity/logo-ascii/style.css": "./identity/logo-ascii/logo-ascii.css",
    "./identity/audio-reactive-logo": "./identity/audio-reactive-logo/dom.ts",
    "./identity/audio-reactive-logo/types": "./identity/audio-reactive-logo/types.ts",
    "./identity/audio-reactive-logo/style.css": "./identity/audio-reactive-logo/audio-reactive-logo.css",
    "./logos": "./logos/index.ts",
    "./logos/logo-black.svg": "./logos/svg/LogoBlack.svg",
    "./logos/logo-black-red.svg": "./logos/svg/LogoBlackRed.svg",
    "./logos/logo-white.svg": "./logos/svg/LogoWhite.svg",
    "./logos/logo-white-red.svg": "./logos/svg/LogoWhiteRed.svg",
    "./logos/logo-yellow.svg": "./logos/svg/LogoYellow.svg",
    "./favicon.ico": "./favicon.ico",
    "./app-icons/favicon.ico": "./app-icons/favicon/favicon.ico",
    "./app-icons/favicon-32.png": "./app-icons/favicon/favicon-32.png",
    "./app-icons/pwa-192.png": "./app-icons/pwa/icon-192.png",
    "./app-icons/pwa-512.png": "./app-icons/pwa/icon-512.png",
    "./app-icons/pwa-maskable-192.png": "./app-icons/pwa/icon-maskable-192.png",
    "./app-icons/pwa-maskable-512.png": "./app-icons/pwa/icon-maskable-512.png",
    "./app-icons/apple-touch.png": "./app-icons/apple/apple-touch-icon.png",
    "./app-icons/windows.ico": "./app-icons/windows/sleepy-studio.ico",
    "./app-icons/macos.icns": "./app-icons/macos/sleepy-studio.icns"
  },
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "app-icons:generate": "node scripts/generate-app-icons.mjs",
    "generate": "pnpm icons:generate && pnpm app-icons:generate",
    "validate": "node scripts/validate.mjs"
  },
  "keywords": ["brand", "design-tokens", "palette", "icons", "assets", "logos", "motion", "ascii", "sleepy-studio"],
  "author": "Sleepy Studio",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/Sleepy-Studio/brand.git" },
  "publishConfig": { "access": "public", "registry": "https://npm.pkg.github.com/" },
  "devDependencies": {
    "@sleepy-studio/contracts": "github:Sleepy-Studio/contracts#79f99e94d99773e54124bee0a8bf7bf3a61f4cc4",
    "lucide-static": "^1.27.0",
    "sharp": "^0.34.3"
  },
  "private": false
}
